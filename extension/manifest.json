{
  "manifest_version": 3,
  "name": "Captivum",
  "version": "0.1.0",
  "description": "Paste a link to a deadline or event, confirm the date, and get a calendar invite in Outlook.",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Captivum"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "scripting",
    "sidePanel",
    "alarms",
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
